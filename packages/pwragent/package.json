{
  "name": "pwragent",
  "version": "1.3.16",
  "private": false,
  "type": "module",
  "description": "PwrAgent owner services under Node, with a foreground Outpost daemon and local CLI.",
  "author": "PwrDrvr LLC <harold@pwrdrvr.com>",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 PwrDrvr LLC",
  "homepage": "https://github.com/pwrdrvr/PwrAgent#readme",
  "bugs": {
    "url": "https://github.com/pwrdrvr/PwrAgent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwrdrvr/PwrAgent.git",
    "directory": "packages/pwragent"
  },
  "keywords": [
    "pwragent",
    "agent",
    "coding-agent",
    "cli"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "dist",
    "licenses",
    "native",
    "scripts/install.mjs",
    "scripts/stage-runtime.mjs",
    "scripts/build-mcp-ipc-relay.mjs",
    "resources/custom-git-runtime.json",
    "resources/git-notices"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "bin": {
    "pwragent": "bin/pwragent.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js scripts/*.test.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "release:check": "node scripts/release.mjs",
    "postinstall": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@pwragent/federation": "workspace:*",
    "@pwragent/shared": "workspace:*",
    "@pwragent/owner-core": "workspace:*",
    "esbuild": "0.28.2",
    "@pwragent/agent-tools": "workspace:*",
    "@pwragent/sqlite-storage": "workspace:*",
    "@pwragent/desktop": "workspace:*"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "node-pty": "1.2.0-beta.15",
    "@napi-rs/canvas": "1.1.0",
    "electron-log": "5.4.3"
  }
}
