{
  "name": "pwragent",
  "version": "0.1.0-alpha.1",
  "private": false,
  "type": "module",
  "description": "Experimental headless PwrAgent daemon and command-line client.",
  "author": "PwrDrvr LLC <harold@pwrdrvr.com>",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 PwrDrvr LLC",
  "homepage": "https://github.com/pwrdrvr/PwrAgent#readme",
  "bugs": {
    "url": "https://github.com/pwrdrvr/PwrAgent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwrdrvr/PwrAgent.git",
    "directory": "packages/pwragent"
  },
  "keywords": [
    "pwragent",
    "agent",
    "coding-agent",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "dist",
    "licenses"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "next"
  },
  "bin": {
    "pwragent": "bin/pwragent.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js scripts/*.test.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "release:check": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@pwragent/federation": "workspace:*",
    "@pwragent/shared": "workspace:*",
    "esbuild": "0.28.1",
    "@pwragent/agent-tools": "workspace:*"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15"
  }
}
