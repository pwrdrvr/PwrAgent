{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "lib": ["ES2023", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "node_modules/.cache/pwragent-typecheck/production.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/renderer/**/*",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup/**/*"
  ],
  "references": [
    { "path": "../../packages/agent-tools" },
    { "path": "../../packages/federation" },
    { "path": "../../packages/messaging/interface" },
    { "path": "../../packages/messaging/providers/discord" },
    { "path": "../../packages/messaging/providers/feishu" },
    { "path": "../../packages/messaging/providers/line" },
    { "path": "../../packages/messaging/providers/mattermost" },
    { "path": "../../packages/messaging/providers/slack" },
    { "path": "../../packages/messaging/providers/telegram" },
    { "path": "../../packages/owner-core" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/sqlite-storage" }
  ]
}
