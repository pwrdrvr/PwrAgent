{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/pwragent-typecheck/tests.tsbuildinfo"
  },
  "files": ["src/renderer/src/vite-env.d.ts", "src/renderer/src/test/vitest-matchers.d.ts"],
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "renderer-layout/**/*.ts",
    "renderer-layout/**/*.tsx",
    "scripts/**/*.ts",
    "src/**/*.d.ts",
    "src/**/__tests__/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup/**/*"
  ],
  "exclude": ["src/renderer/**/*"]
}
