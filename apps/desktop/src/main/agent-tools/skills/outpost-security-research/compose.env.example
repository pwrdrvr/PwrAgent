# Settings for compose.yaml. Copy to .env beside it and run `chmod 600 .env`.
# Never put the provider API key here; pass it to `docker compose up` (see compose.yaml).

# The Outpost image from step 1, and the container and volume names.
OUTPOST_IMAGE=pwragent-outpost:research
OUTPOST_CONTAINER=pwragent-outpost
OUTPOST_VOLUME=pwragent-outpost-home
OUTPOST_SECCOMP=./seccomp-outpost.json

# The federation gateway, as the egress container reaches it. host.docker.internal
# is the Docker host.
GATEWAY_HOST=host.docker.internal
GATEWAY_PORT=

# The gateway endpoint the Outpost saved at enrollment, if it differs from
# 127.0.0.1:GATEWAY_PORT. `pwragent federation-status` shows it.
# OUTPOST_ENDPOINT_HOST=
# OUTPOST_ENDPOINT_PORT=

# The model upstream. A model served on the Docker host is
# http://host.docker.internal:<port>/v1.
MODEL_PROXY_UPSTREAM=https://<provider-host>/v1

# MODEL_PROXY_PLACEHOLDER, the token the Outpost uses instead of a key, is the
# line step 2 appends. Keep it the only one: step 5 reads it back with sed.
