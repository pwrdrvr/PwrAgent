+// Investigation-only tracing. Each transition records the completed phase and
+// names the next one before awaiting it, so a timeout retains the pending phase.
+function createStartupPhaseTrace(): (name: string) => void {
+  const started = performance.now();
+  let previous = started;
+  let cpu = process.cpuUsage();
+  let pending: string | undefined;
+  return (next) => {
+    const now = performance.now();
+    const currentCpu = process.cpuUsage();
+    process.stderr.write(`[messaging-startup] ${JSON.stringify({
+      pid: process.pid,
+      completed: pending ?? null,
+      next,
+      elapsedMs: now - started,
+      phaseMs: now - previous,
+      cpuMs: (currentCpu.user - cpu.user + currentCpu.system - cpu.system) / 1_000,
+    })}\n`);
+    previous = now;
+    cpu = currentCpu;
+    pending = next;
+  };
+}
